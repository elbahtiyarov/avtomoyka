# Переменные окружения — скопируйте этот файл в .env и заполните своими значениями.
# Сам .env в git не попадает (см. .gitignore) — в нём секреты.
DB_HOST=localhost
DB_PORT=5432
DB_USER=avtomoyka_user
DB_PASSWORD=changeme
DB_NAME=avtomoyka

PORT=3002

# Секрет для подписи токенов входа — обязательно замените на свою случайную строку
JWT_SECRET=change-me-to-a-long-random-string

# SMS-шлюз для кода подтверждения при списании бонусных баллов.
# console — код просто печатается в консоль сервера, ничего не отправляется реально
#           (значение по умолчанию, удобно для проверки без платного шлюза)
# mobizon — https://mobizon.kz (заполните SMS_API_KEY)
# smsc    — https://smsc.kz (заполните SMS_API_LOGIN и SMS_API_KEY)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_LOGIN=
